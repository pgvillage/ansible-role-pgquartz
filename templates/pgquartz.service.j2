# {{ ansible_managed }}
# Runs pgQuartz job {{ item.label }} once. Started by {{ item.unit }}.timer.

[Unit]
Description=pgQuartz job {{ item.label }}
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ pgquartz_osuser }}
Group={{ pgquartz_osgroup }}
ExecStart=/usr/bin/pgquartz -c "{{ item.config }}"
